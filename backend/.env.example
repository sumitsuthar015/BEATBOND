# Server
PORT=5002
CLIENT_URL=https://beatbond-75ns.onrender.com

# MongoDB Atlas connection string. Replace with the URI from Atlas Connect > Drivers.
# The database user password must be URL-encoded if it contains special characters.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority

# Use these only if the network DNS server blocks Atlas SRV records.
MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1

# Clerk authentication
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Cloudinary uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Groq chat
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-120b

# JioSaavn relay (production only). JioSaavn hides many songs from servers
# outside India, so a backend hosted abroad should route through the relay in
# ../saavn-relay. Leave both empty locally to call JioSaavn directly.
SAAVN_API_BASE=
SAAVN_RELAY_KEY=

# Generate a matching VAPID pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=replace-with-generated-public-key
VAPID_PRIVATE_KEY=replace-with-generated-private-key
VAPID_SUBJECT=mailto:support@beatbond.app

# Use the same Redis URL on every backend instance to share realtime events/presence.
# Leave blank for single-instance local development.
REDIS_URL=
REALTIME_REDIS_PREFIX=beatbond:realtime
