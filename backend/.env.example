# Server
PORT=5002
CLIENT_URL=https://beatbond-75ns.onrender.com

# MongoDB Atlas connection string. Replace with the URI from Atlas Connect > Drivers.
# The database user password must be URL-encoded if it contains special characters.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority

# Use these only if the network DNS server blocks Atlas SRV records.
MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1

# Clerk authentication
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Cloudinary uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Groq chat
GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
