@startuml
title BeatBond - Use Case Diagram
left to right direction
actor "Music Listener" as User
actor Administrator as Admin
actor Clerk
actor "Saavn API" as Saavn
actor "Groq AI" as Groq
actor "Cloudinary" as Cloudinary
actor "Mapbox / Leaflet" as Maps
rectangle BeatBond {
  usecase "Sign in and manage profile" as Auth
  usecase "Search and browse music" as Search
  usecase "Stream song and view lyrics" as Stream
  usecase "Like songs and artists" as Like
  usecase "Create and manage playlists" as Playlist
  usecase "Download playlists for offline use" as Download
  usecase "Get mood-based playlist" as Mood
  usecase "Chat with AI therapy assistant" as Therapy
  usecase "Send/respond to friend requests" as Friends
  usecase "View shared listening activity" as Activity
  usecase "Send real-time private messages" as Chat
  usecase "View notifications" as Notifications
  usecase "Create posts and comments" as Social
  usecase "Create avatar and upload profile photo" as Avatar
  usecase "Share/view location on map" as Location
  usecase "Manage songs and albums" as Manage
}
User --> Auth
User --> Search
User --> Stream
User --> Like
User --> Playlist
User --> Download
User --> Mood
User --> Therapy
User --> Friends
User --> Activity
User --> Chat
User --> Notifications
User --> Social
User --> Avatar
User --> Location
Admin --> Manage
Auth --> Clerk
Search --> Saavn
Stream --> Saavn
Mood --> Saavn
Therapy --> Groq
Avatar --> Cloudinary
Location --> Maps
Download .> Playlist : <<extend>>
Activity .> Stream : <<extend>>
@enduml
