@startuml
title BeatBond - Component Diagram
skinparam componentStyle rectangle
package "Frontend: React 18 / Vite PWA" {
  [React Router Pages] as Pages
  [Zustand Stores] as Zustand
  [TanStack React Query] as Query
  [Audio Player] as Player
  [Socket.IO Client] as SocketClient
  [Offline Download Cache] as Cache
  [Map UI] as MapUI
}
package "Backend: Node.js / Express" {
  [REST API Routes] as API
  [Clerk Authentication Middleware] as Auth
  [Music and Search Controllers] as Music
  [Playlist and Library Controllers] as Library
  [Social Controllers] as Social
  [Chat Controller and Socket.IO] as Chat
  [Mood Curation Service] as Mood
  [Groq Therapy Chat Controller] as Therapy
  [Location and Avatar Controllers] as Profile
  [Admin Controllers] as Admin
}
database "MongoDB via Mongoose" as Mongo
cloud Clerk
cloud "Saavn API/SDK" as Saavn
cloud "Groq SDK" as Groq
cloud Cloudinary
cloud "Mapbox / Leaflet" as Maps
Pages --> Zustand
Pages --> Query
Pages --> Player
Pages --> SocketClient
Pages --> MapUI
Query --> API : HTTPS REST
SocketClient --> Chat : WebSocket
Player --> Cache : offline media
API --> Auth
API --> Music
API --> Library
API --> Social
API --> Chat
API --> Mood
API --> Therapy
API --> Profile
API --> Admin
Auth --> Clerk
Music --> Saavn
Mood --> Saavn
Therapy --> Groq
Profile --> Cloudinary
MapUI --> Maps
Music --> Mongo
Library --> Mongo
Social --> Mongo
Chat --> Mongo
Profile --> Mongo
Admin --> Mongo
@enduml
