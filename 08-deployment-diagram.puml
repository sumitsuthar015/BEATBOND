@startuml
title BeatBond - Deployment Diagram
node "User Device" as Device {
  artifact "Modern Browser" as Browser
  artifact "BeatBond React PWA\nVite build and service worker" as PWA
  Browser -- PWA
}
cloud Internet
node "Web Hosting" as WebHost {
  artifact "Frontend static files" as Static
}
node "Application Server\nNode.js 20+" as AppServer {
  component "Express.js 4.21 API" as API
  component "Socket.IO 4.8 Server" as Socket
  component "node-cron temp-file cleanup" as Cron
}
database "MongoDB 6.x / Atlas\nMongoose 8.8" as Mongo
cloud "Clerk Authentication" as Clerk
cloud "Saavn API/SDK\nCatalogue and streams" as Saavn
cloud "Groq AI\nTherapy chat" as Groq
cloud "Cloudinary\nProfile media" as Cloudinary
cloud "Mapbox services" as Mapbox
PWA --> Internet : HTTPS / WSS
Internet --> WebHost : load frontend
PWA --> API : REST over HTTPS
PWA --> Socket : WebSocket
API --> Mongo : database operations
Socket --> Mongo : messages, users, notifications
API --> Clerk : token verification
API --> Saavn : music search and metadata
PWA --> Saavn : audio streaming
API --> Groq : AI therapy conversation
API --> Cloudinary : profile photo upload
PWA --> Mapbox : map display
Cron --> AppServer : hourly job
@enduml
